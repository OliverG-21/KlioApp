<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KlioApp.UI.ViewModels"
             x:Class="KlioApp.UI.Views.UploadQueueView"
             x:DataType="vm:UploadViewModel">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="8,6"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Upload-Warteschlange" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Command="{Binding ClearCompletedCommand}"
                            IsEnabled="{Binding !IsUploading}">
                        Fertige entfernen
                    </Button>
                    <Button Command="{Binding ClearAllCommand}"
                            IsEnabled="{Binding !IsUploading}"
                            ToolTip.Tip="Alle Einträge aus der Warteschlange entfernen">
                        Alles leeren
                    </Button>
                </StackPanel>
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                             IsVisible="{Binding IsUploading}"/>
            </StackPanel>
        </Border>

        <!-- Queue list -->
        <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding Queue}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:UploadItemViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding FileName}" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TargetAlbumName}" FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <Border IsVisible="{Binding TagSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Background="{DynamicResource SystemAccentColor}"
                                    CornerRadius="3" Padding="4,1"
                                    HorizontalAlignment="Left"
                                    ToolTip.Tip="{Binding TagSummary}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="🏷" FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TagCount}" FontSize="9" FontWeight="SemiBold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                   VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>
